generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYER
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  companyName  String?
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

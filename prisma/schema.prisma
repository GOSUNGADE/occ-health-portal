generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model booking_consents {
  id            BigInt     @id @default(autoincrement())
  booking_id    BigInt     @unique
  candidate_id  BigInt
  consent_given Boolean    @default(false)
  full_name     String
  signed_at     DateTime   @default(now()) @db.Timestamp(6)
  created_at    DateTime   @default(now()) @db.Timestamp(6)
  updated_at    DateTime   @default(now()) @db.Timestamp(6)
  bookings      bookings   @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  candidates    candidates @relation(fields: [candidate_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model booking_documents {
  id            BigInt   @id @default(autoincrement())
  booking_id    BigInt
  original_name String
  stored_name   String
  file_url      String
  mime_type     String?
  file_size     BigInt?
  uploaded_at   DateTime @default(now()) @db.Timestamp(6)
  bookings      bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model booking_questionnaires {
  id               BigInt     @id @default(autoincrement())
  booking_id       BigInt     @unique
  candidate_id     BigInt
  medical_history  String?
  current_symptoms String?
  medications      String?
  allergies        String?
  submitted        Boolean    @default(false)
  created_at       DateTime   @default(now()) @db.Timestamp(6)
  updated_at       DateTime   @default(now()) @db.Timestamp(6)
  bookings         bookings   @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  candidates       candidates @relation(fields: [candidate_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bookings {
  id                                          BigInt                  @id @default(autoincrement())
  employer_id                                 BigInt
  candidate_id                                BigInt
  appointment_date                            DateTime                @db.Date
  status                                      String                  @default("SCHEDULED")
  notes                                       String?
  created_at                                  DateTime                @default(now()) @db.Timestamp(6)
  updated_at                                  DateTime                @default(now()) @db.Timestamp(6)
  assessment_type                             String?
  appointment_time                            DateTime?               @db.Time(6)
  clinic_location                             String?
  assigned_clinician                          String?
  priority                                    String?                 @default("STANDARD")
  assigned_clinician_id                       BigInt?
  booking_consents                            booking_consents?
  booking_documents                           booking_documents[]
  booking_questionnaires                      booking_questionnaires?
  users_bookings_assigned_clinician_idTousers users?                  @relation("bookings_assigned_clinician_idTousers", fields: [assigned_clinician_id], references: [id], onUpdate: NoAction)
  candidates                                  candidates              @relation(fields: [candidate_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_bookings_employer_idTousers           users                   @relation("bookings_employer_idTousers", fields: [employer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model candidate_invites {
  id           BigInt     @id @default(autoincrement())
  candidate_id BigInt
  email        String
  token        String     @unique
  expires_at   DateTime   @db.Timestamp(6)
  used_at      DateTime?  @db.Timestamp(6)
  created_at   DateTime   @default(now()) @db.Timestamp(6)
  candidates   candidates @relation(fields: [candidate_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model candidates {
  id                                     BigInt                   @id @default(autoincrement())
  employer_id                            BigInt
  full_name                              String
  email                                  String?
  phone                                  String?
  date_of_birth                          DateTime?                @db.Date
  notes                                  String?
  created_at                             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                             DateTime                 @default(now()) @db.Timestamptz(6)
  linked_user_id                         BigInt?
  booking_consents                       booking_consents[]
  booking_questionnaires                 booking_questionnaires[]
  bookings                               bookings[]
  candidate_invites                      candidate_invites[]
  users_candidates_employer_idTousers    users                    @relation("candidates_employer_idTousers", fields: [employer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_candidates_linked_user_idTousers users?                   @relation("candidates_linked_user_idTousers", fields: [linked_user_id], references: [id], onUpdate: NoAction)

  @@index([employer_id], map: "idx_candidates_employer_id")
}

model password_reset_tokens {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  token      String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token], map: "idx_password_reset_tokens_token")
  @@index([user_id], map: "idx_password_reset_tokens_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                                             BigInt                  @id @default(autoincrement())
  full_name                                      String
  company_name                                   String?
  email                                          String                  @unique
  password_hash                                  String
  role                                           String                  @default("EMPLOYER")
  created_at                                     DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                                     DateTime                @default(now()) @db.Timestamptz(6)
  is_active                                      Boolean                 @default(true)
  must_change_password                           Boolean                 @default(false)
  bookings_bookings_assigned_clinician_idTousers bookings[]              @relation("bookings_assigned_clinician_idTousers")
  bookings_bookings_employer_idTousers           bookings[]              @relation("bookings_employer_idTousers")
  candidates_candidates_employer_idTousers       candidates[]            @relation("candidates_employer_idTousers")
  candidates_candidates_linked_user_idTousers    candidates[]            @relation("candidates_linked_user_idTousers")
  password_reset_tokens                          password_reset_tokens[]
}
